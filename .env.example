# ═══════════════════════════════════════════════════════════════════════════════
# VTP Platform - Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# REQUIRED - These must be set for the application to start
# ─────────────────────────────────────────────────────────────────────────────────

# JWT Secret - MUST be changed in production (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vtp_db?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vtp_db

# ─────────────────────────────────────────────────────────────────────────────────
# OPTIONAL - Defaults are provided, customize as needed
# ─────────────────────────────────────────────────────────────────────────────────

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Server Configuration
PORT=8080
NODE_ENV=production

# JWT Token Expiry
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=168

# Mediasoup SFU Configuration
MEDIASOUP_URL=http://mediasoup:3000
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=0.0.0.0

# Jitsi Configuration (default public server)
JITSI_SERVER_URL=https://meet.jit.si

# ─────────────────────────────────────────────────────────────────────────────────
# EMAIL - Required for password reset functionality
# ─────────────────────────────────────────────────────────────────────────────────

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
FROM_EMAIL=noreply@yourplatform.com
RESET_BASE_URL=https://yourplatform.com/reset-password

# ─────────────────────────────────────────────────────────────────────────────────
# CDN - For video streaming distribution (optional)
# ─────────────────────────────────────────────────────────────────────────────────

CDN_URL=

# ─────────────────────────────────────────────────────────────────────────────────
# WEBRTC - TURN server for NAT traversal (required for production)
# ─────────────────────────────────────────────────────────────────────────────────

TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────────
# S3/MinIO - For recording storage (optional)
# ─────────────────────────────────────────────────────────────────────────────────

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vtp-recordings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# ─────────────────────────────────────────────────────────────────────────────────
# RECORDING - Local file storage
# ─────────────────────────────────────────────────────────────────────────────────

RECORDING_DIR=/tmp/vtp-recordings
FFMPEG_PATH=/usr/bin/ffmpeg

# ─────────────────────────────────────────────────────────────────────────────────
# CORS - Allowed origins (comma-separated)
# ─────────────────────────────────────────────────────────────────────────────────

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────────
# FRONTEND URLs
# ─────────────────────────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────────
# PGADMIN - Database admin panel (development only)
# ─────────────────────────────────────────────────────────────────────────────────

PGADMIN_EMAIL=admin@vtp.local
PGADMIN_PASSWORD=admin123

# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION DEPLOYMENT (DigitalOcean + Vercel)
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# VERCEL FRONTEND - Set in Vercel Dashboard
# ─────────────────────────────────────────────────────────────────────────────────

# NEXT_PUBLIC_API_URL=https://your-app.ondigitalocean.app
# NEXT_PUBLIC_WS_URL=wss://your-app.ondigitalocean.app
# NEXT_PUBLIC_MEDIASOUP_URL=wss://your-mediasoup-droplet:3000
# NEXT_PUBLIC_JITSI_SERVER=https://meet.jit.si

# ─────────────────────────────────────────────────────────────────────────────────
# DIGITALOCEAN APP PLATFORM - Set in App Platform Dashboard
# ─────────────────────────────────────────────────────────────────────────────────

# DATABASE_URL - Auto-injected from managed PostgreSQL
# REDIS_URL - Auto-injected from managed Redis
# JWT_SECRET - Set as secret in App Platform

# ─────────────────────────────────────────────────────────────────────────────────
# GOOGLE MEET INTEGRATION (Phase 3 - Optional)
# ─────────────────────────────────────────────────────────────────────────────────

# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://your-app.ondigitalocean.app/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────────
# ZOOM INTEGRATION (Phase 3 - Optional)
# ─────────────────────────────────────────────────────────────────────────────────

# ZOOM_CLIENT_ID=your-zoom-client-id
# ZOOM_CLIENT_SECRET=your-zoom-client-secret
# ZOOM_REDIRECT_URI=https://your-app.ondigitalocean.app/auth/zoom/callback
